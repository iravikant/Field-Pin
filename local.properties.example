## Copy to local.properties (git-ignored). NEVER commit the real file.

# Google Maps SDK for Android key. Optional for building (the app builds and runs without it,
# the map just shows a "key missing" notice). Create one in Google Cloud Console:
#   1. enable "Maps SDK for Android"
#   2. Credentials -> API key -> restrict to Android apps: package com.fieldpin + your SHA-1
MAPS_API_KEY=

# Base URLs per build type (exposed as BuildConfig.API_BASE_URL). Optional.
API_BASE_URL_DEBUG=https://mock.debug.fieldpin.test/v1/
API_BASE_URL_RELEASE=https://mock.fieldpin.test/v1/

# XYZ tile template for the offline map pack saved on first run. Default is OpenStreetMap's public
# server (fine for this small demo pack; read https://operations.osmfoundation.org/policies/tiles/).
# Use a provider that permits offline storage for production.
TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
